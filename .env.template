# Copy to `.env` and fill values. Missing vars fall back to defaults in code.
# BASE_API_URL and BASE_CIAM_URL are REQUIRED (raise on import if empty).

# --- XL endpoints (REQUIRED) ---
# BASE_API_URL — root for Ah-Si-Ata backend (profile, packages, payments, etc.)
# BASE_CIAM_URL — root for OIDC identity provider (OTP, token refresh)

BASE_API_URL="https://api.myxl.xlaxiata.co.id"
BASE_CIAM_URL="https://gede.ciam.xlaxiata.co.id"

# --- Auth (REQUIRED) ---
# BASIC_AUTH — base64(client_id:secret) for `Authorization: Basic` on CIAM.
# AX_FP_KEY  — AES-256 secret for encrypting the device fingerprint (`ax.fp`).
# UA        — User-Agent header; must mimic MyXL Android app.

BASIC_AUTH="OWZjOTdlZDEtNmEzMC00OGQ1LTk1MTYtNjBjNTNjZTNhMTM1OllEV21GNExKajlYSUt3UW56eTJlMmxiMHRKUWIyOW8z"
AX_FP_KEY="18b4d589826af50241177961590e6693"
UA="myXL / 8.9.0(1202); com.android.vending; (oppo; CPH2737; SDK 33; Android 13)"

# --- API key (REQUIRED) ---
# API_KEY — `x-api-key` header on main-backend requests.

API_KEY="vT8tINqHaOxXbGE7eOWAhA=="

# --- Encryption keys (REQUIRED) ---
# ENCRYPTED_FIELD_KEY — AES key for `encrypted_payment_token`,
#                       `encrypted_authentication_id`, Circle MSISDN.

ENCRYPTED_FIELD_KEY="5dccbf08920a5527"

# --- Signing secrets (REQUIRED) ---
# XDATA_KEY         — AES key for `xdata` request body encryption.
# AX_API_SIG_KEY    — HMAC-SHA256 key for `Ax-Api-Signature` on CIAM.
# X_API_BASE_SECRET — base secret for HMAC-SHA512 `x-signature` headers.

XDATA_KEY="5dccbf08920a5527b99e222789c34bb7"
AX_API_SIG_KEY="18b4d589826af50241177961590e6693"
X_API_BASE_SECRET="mU1Y4n1vBjf3M7tMnRkFU08mVyUJHed8B5En3EAniu1mXLixeuASmBmKnkyzVziOye7rG5nIekMdthensbQMcOJ6SLnrkGyfXALD7mrBC6vuWv6G01pmD3XlU5rT7Tzx"

# --- Optional (have defaults) ---
# PAYMENT_SIGN_SALT    — opaque salt in HMAC key for payment/bounty/loyalty
#                        `x-signature`. Keeps key opaque without X_API_BASE_SECRET.
# DEVICE_MANUFACTURER  — CIAM header `Ax-Request-Device` (e.g. "samsung").
# DEVICE_MODEL         — CIAM header `Ax-Request-Device-Model` and
#                        `app_version` payload field.
# DEVICE_FAKE_MSISDN   — fallback MSISDN for first-run fingerprint gen.
# APP_VERSION          — `x-version-app` header on main-backend.
# X_HV                 — `x-hv` header; gates protocol/feature per client.
# DEFAULT_SUBSTYPE     — `Ax-Substype` header on pre-auth CIAM requests.
# TOKEN_REFRESH_INTERVAL — seconds between auto OIDC token rotations.

PAYMENT_SIGN_SALT="ae-hei_9Tee6he+Ik3Gais5="
DEVICE_MANUFACTURER="samsung"
DEVICE_MODEL="SM-N935F"
DEVICE_FAKE_MSISDN="6281398370564"
APP_VERSION="8.9.0"
X_HV="v3"
DEFAULT_SUBSTYPE="PREPAID"
TOKEN_REFRESH_INTERVAL="300"
